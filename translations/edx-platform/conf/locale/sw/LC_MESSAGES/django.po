msgstr "Ufunguo wa kozi sharti ikiwa kozi hii ina kozi sharti"

#: xmodule/course_block.py:399
msgid "Grading policy definition for this class"
msgstr "Ufafanuzi wa sera ya upimaji kwa darasa hili"

