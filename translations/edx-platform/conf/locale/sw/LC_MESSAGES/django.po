msgid "Date that enrollment for this class is closed"
msgstr "Tarehe ambayo uandikishaji wa darasa hili unafungwa"

#: xmodule/course_block.py:366
msgid "Start time when this block is visible"
msgstr "Muda wa kuanza ambapo kizuizi hiki kinaonekana"

#: xmodule/course_block.py:370
msgid "Date that this class ends"
msgstr "Tarehe ambayo darasa hili linaisha"

#: xmodule/course_block.py:372
msgid "Date that certificates become available to learners"
msgstr "Tarehe ambayo vyeti vinapatikana kwa wanafunzi"

#: xmodule/course_block.py:376
msgid "Cosmetic Course Display Price"
msgstr "Bei ya Kuonyesha Kozi (ya mapambo)"

#: xmodule/course_block.py:378
msgid ""
"The cost displayed to students for enrolling in the course. If a paid course"
" registration price is set by an administrator in the database, that price "
"will be displayed instead of this one."
msgstr ""
"Gharama inayoonyeshwa kwa wanafunzi kwa ajili ya kujiandikisha kwenye kozi. "
"Ikiwa bei ya usajili wa kozi ya kulipia imewekwa na msimamizi kwenye "
"hifadhidata, bei hiyo itaonyeshwa badala ya hii."

#: xmodule/course_block.py:385
msgid "Course Advertised Start"
msgstr "Mwanzo wa Kozi Uliotangazwa"

#: xmodule/course_block.py:387
msgid ""
"Enter the text that you want to use as the advertised starting time frame "
"for the course, such as \"Winter 2018\". If you enter null for this value, "
"the start date that you have set for this course is used."
msgstr ""
"Weka maandishi unayotaka kutumia kama muda wa kuanza uliotangazwa wa kozi, "
"kama vile \"Winter 2018\". Ukiweka null kwa thamani hii, tarehe ya kuanza "
"uliyoweka kwa kozi hii itatumika."

#: xmodule/course_block.py:394
msgid "Pre-Requisite Courses"
msgstr "Kozi Sharti"

