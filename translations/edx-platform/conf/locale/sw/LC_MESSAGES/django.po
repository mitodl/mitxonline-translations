msgstr ""
"Weka pasipoti za zana za LTI za kozi katika muundo ufuatao: "
"\"id:client_key:client_secret\"."

#: xmodule/course_block.py:353
msgid ""
"List of Textbook objects with (title, url) for textbooks used in this course"
msgstr ""
"Orodha ya vitu vya Kitabu cha Kiada (Textbook) vyenye (title, url) kwa "
"vitabu vya kiada vinavyotumika katika kozi hii"

